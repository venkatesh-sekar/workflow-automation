FLOW_API_KEY="api-key"
FLOW_CACHE_PATH="./dev/cache"
FLOW_CHATBOT_ENABLED=true
FLOW_CONFIG_PATH="./dev/config"
FLOW_DB_TYPE=PGLITE
FLOW_ENRICH_ERROR_CONTEXT=true
FLOW_ENVIRONMENT="dev"
FLOW_FRONTEND_URL="http://localhost:4200"
FLOW_LOG_LEVEL=debug
FLOW_LOG_PRETTY=true
FLOW_QUEUE_MODE=MEMORY
FLOW_TELEMETRY_ENABLED=false
FLOW_TRIGGER_DEFAULT_POLL_INTERVAL=1
FLOW_WEBHOOK_TIMEOUT_SECONDS=30
FLOW_WEBHOOK_URL="http://localhost:3000"
FLOW_WORKER_CONCURRENCY=1
FLOW_VAULT_ADDR=http://localhost:8200
FLOW_VAULT_USERNAME=flow
