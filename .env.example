# ============================================================================
# Flow — Environment Configuration
# ============================================================================
# Copy this file to .env.production and fill in the values.
# Variables marked [REQUIRED] must be set. Others have sensible defaults.

# --- Core -------------------------------------------------------------------

# Container mode: APP (API only), WORKER (worker only), WORKER_AND_APP (both)
# In split deployment, set APP for api container and WORKER for worker container
FLOW_CONTAINER_TYPE=APP

# Environment: prod or dev
FLOW_ENVIRONMENT=prod

# [REQUIRED] 32-char hex key for encrypting sensitive data (connections, tokens)
# Generate with: openssl rand -hex 16
FLOW_ENCRYPTION_KEY=

# [REQUIRED] Secret for signing JWT tokens — use a long random string
# Generate with: openssl rand -base64 32
FLOW_JWT_SECRET=

# Public URL where users access the UI (used for OAuth callbacks, emails, etc.)
FLOW_FRONTEND_URL=http://localhost:8080

# Internal URL the worker uses to reach the API (webhooks, internal calls)
FLOW_WEBHOOK_URL=http://flow-api:3000

# --- Database (PostgreSQL) --------------------------------------------------

FLOW_DB_TYPE=POSTGRES
FLOW_POSTGRES_HOST=postgres
FLOW_POSTGRES_PORT=5432
FLOW_POSTGRES_DATABASE=flow
FLOW_POSTGRES_USERNAME=flow

# [REQUIRED] Database password — change from default in production!
FLOW_POSTGRES_PASSWORD=flow

# Optional: connection string (overrides individual host/port/db/user/pass)
# FLOW_POSTGRES_URL=postgresql://flow:flow@postgres:5432/flow

# Optional: connection pool and SSL
# FLOW_POSTGRES_POOL_SIZE=10
# FLOW_POSTGRES_IDLE_TIMEOUT_MS=30000
# FLOW_POSTGRES_USE_SSL=false
# FLOW_POSTGRES_SSL_CA=/path/to/ca.pem

# --- Redis -------------------------------------------------------------------

FLOW_REDIS_HOST=redis
FLOW_REDIS_PORT=6379
# FLOW_REDIS_PASSWORD=
# FLOW_REDIS_USER=
# FLOW_REDIS_DB=0
# FLOW_REDIS_USE_SSL=false

# Optional: connection string (overrides individual settings)
# FLOW_REDIS_URL=redis://redis:6379

# Optional: Redis Sentinel
# FLOW_REDIS_TYPE=sentinel
# FLOW_REDIS_SENTINEL_HOSTS=host1:26379,host2:26379
# FLOW_REDIS_SENTINEL_NAME=mymaster
# FLOW_REDIS_SENTINEL_ROLE=master

# --- Queue -------------------------------------------------------------------

FLOW_QUEUE_MODE=REDIS

# --- Execution ---------------------------------------------------------------

# UNSANDBOXED or SANDBOXED (sandboxed requires Docker-in-Docker)
FLOW_EXECUTION_MODE=UNSANDBOXED

# Max seconds a flow can run before timeout
# FLOW_FLOW_TIMEOUT_SECONDS=600

# Max seconds for webhook processing
# FLOW_WEBHOOK_TIMEOUT_SECONDS=30

# Max seconds for triggers
# FLOW_TRIGGER_TIMEOUT_SECONDS=60
# FLOW_TRIGGER_HOOKS_TIMEOUT_SECONDS=60

# Default polling interval for triggers (seconds)
# FLOW_TRIGGER_DEFAULT_POLL_INTERVAL=300

# --- Worker ------------------------------------------------------------------

# Number of concurrent flow executions per worker
FLOW_WORKER_CONCURRENCY=10

# FLOW_WORKER_TOKEN=
# FLOW_PRE_WARM_CACHE=true

# --- Pieces ------------------------------------------------------------------

FLOW_PIECES_SYNC_MODE=NONE
# FLOW_PIECES_CACHE_MAX_ENTRIES=100

# --- Logging -----------------------------------------------------------------

FLOW_LOG_LEVEL=info
# FLOW_LOG_PRETTY=false

# --- Telemetry ---------------------------------------------------------------

FLOW_TELEMETRY_ENABLED=false

# --- SMTP (email notifications) ---------------------------------------------

# FLOW_SMTP_HOST=smtp.example.com
# FLOW_SMTP_PORT=587
# FLOW_SMTP_USERNAME=
# FLOW_SMTP_PASSWORD=
# FLOW_SMTP_SENDER_EMAIL=flow@example.com
# FLOW_SMTP_SENDER_NAME=Flow

# --- S3 Storage (optional, for file storage) ---------------------------------

# FLOW_FILE_STORAGE_LOCATION=DB
# FLOW_S3_ENDPOINT=
# FLOW_S3_REGION=
# FLOW_S3_BUCKET=
# FLOW_S3_ACCESS_KEY_ID=
# FLOW_S3_SECRET_ACCESS_KEY=
# FLOW_S3_USE_SIGNED_URLS=false

# --- Admin -------------------------------------------------------------------

# FLOW_ADMIN_EMAIL=admin@flow.local
# FLOW_ADMIN_API_KEY=

# --- Rate Limiting -----------------------------------------------------------

# FLOW_API_RATE_LIMIT_AUTHN_ENABLED=false
# FLOW_API_RATE_LIMIT_AUTHN_MAX=100
# FLOW_API_RATE_LIMIT_AUTHN_WINDOW=60

# --- Data Retention ----------------------------------------------------------

# FLOW_EXECUTION_DATA_RETENTION_DAYS=30
# FLOW_ISSUE_ARCHIVE_DAYS=14
# FLOW_PAUSED_FLOW_TIMEOUT_DAYS=180
# FLOW_REDIS_FAILED_JOB_RETENTION_DAYS=30

# --- UI Container (only for docker-compose.split.yml) -----------------------

# Backend API URL that the UI nginx container proxies to
# FLOW_API_URL=http://flow-api:3000

# --- Observability (optional) ------------------------------------------------

# FLOW_OTEL_ENABLED=false
# FLOW_LOKI_URL=
# FLOW_LOKI_USERNAME=
# FLOW_LOKI_PASSWORD=
