### STAGE 1: Build frontend ###
FROM node:22-bullseye-slim AS build

WORKDIR /usr/src/app

# Copy all source (needed for shared package types used by web)
COPY . .

# Install root dev dependencies
RUN --mount=type=cache,target=/root/.npm \
    npm install --legacy-peer-deps 2>&1 | tail -5

# Install shared package deps (web imports types from these)
RUN --mount=type=cache,target=/root/.npm \
    cd packages/shared && npm install --legacy-peer-deps 2>&1 | tail -3

# Install web deps
RUN --mount=type=cache,target=/root/.npm \
    cd packages/web && npm install --legacy-peer-deps 2>&1 | tail -3

# Build shared packages (web depends on types from these)
RUN cd packages/shared && npm run build

# Build web frontend
RUN cd packages/web && npm run build

### STAGE 2: Nginx to serve static files ###
FROM nginx:1.27-alpine AS run

# Install envsubst (part of gettext)
RUN apk add --no-cache gettext

# Copy built frontend
COPY --from=build /usr/src/app/dist/packages/web/ /usr/share/nginx/html/

# Copy nginx config as template (envsubst will process it at runtime)
COPY nginx.ui.conf /etc/nginx/nginx.conf.template

# Copy entrypoint
COPY docker-entrypoint.ui.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

LABEL service=flow-ui

ENTRYPOINT ["/docker-entrypoint.sh"]
EXPOSE 80
