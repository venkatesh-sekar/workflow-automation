{
  "compileOnSave": false,
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@activepieces/engine": ["packages/server/engine/src/main.ts"],
      "@activepieces/pieces-common": ["packages/pieces/common/src/index.ts"],
      "@activepieces/pieces-framework": ["packages/pieces/framework/src/index.ts"],
      "@activepieces/server-common": ["packages/server/common/src/index.ts"],
      "@activepieces/shared": ["packages/shared/src/index.ts"],
      "worker": ["packages/server/worker/src/index.ts"]
    }
  }
}
